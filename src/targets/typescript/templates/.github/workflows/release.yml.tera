name: Release

on:
  push:
    branches: [main]
    tags:
      - "v*"

jobs:
  release:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    permissions:
      contents: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v6.4.0
        with:
          node-version: '22'
      - run: npm ci
      - run: npm run build
      - run: npm test
      - run: npx semantic-release
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          NPM_TOKEN: {% raw %}${{ secrets.NPM_TOKEN }}{% endraw %}

  # Publishes the Dockerfile's image to GHCR, versioned by the release tag.
  # Builds each platform natively on its own runner (no QEMU emulation) and
  # pushes it by digest only, then merge-image combines the digests into
  # one multi-arch manifest — Docker's documented pattern for
  # build-push-action: https://docs.docker.com/build/ci/github-actions/multi-platform/
  # ubuntu-24.04-arm is a GitHub-hosted native arm64 runner (not emulated),
  # free for public repos and billed at the same/lower per-minute rate as
  # amd64 for private ones.
  build-image:
    if: startsWith(github.ref, 'refs/tags/v')
    strategy:
      fail-fast: false
      matrix:
        platform:
          - { arch: amd64, runner: ubuntu-24.04 }
          - { arch: arm64, runner: ubuntu-24.04-arm }
    runs-on: {% raw %}${{ matrix.platform.runner }}{% endraw %}
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v7
      - uses: docker/setup-buildx-action@v4.2.0
      - uses: docker/login-action@v4.4.0
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Compute image name
        id: image
        # GHCR image names must be lowercase, but github.repository isn't
        # guaranteed to be (e.g. a mixed-case GitHub username/org).
        run: echo "name=ghcr.io/$(echo '{% raw %}${{ github.repository }}{% endraw %}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_OUTPUT"
      - name: Build and push by digest
        id: build
        uses: docker/build-push-action@v7.3.0
        with:
          context: .
          platforms: linux/{% raw %}${{ matrix.platform.arch }}{% endraw %}
          outputs: type=image,name={% raw %}${{ steps.image.outputs.name }}{% endraw %},push-by-digest=true,name-canonical=true,push=true
      - name: Export digest
        run: |
          mkdir -p /tmp/digests
          digest="{% raw %}${{ steps.build.outputs.digest }}{% endraw %}"
          touch "/tmp/digests/${digest#sha256:}"
      - name: Upload digest
        uses: actions/upload-artifact@v7
        with:
          name: digests-{% raw %}${{ matrix.platform.arch }}{% endraw %}
          path: /tmp/digests/*
          if-no-files-found: error
          retention-days: 1

  merge-image:
    needs: build-image
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Download digests
        uses: actions/download-artifact@v8
        with:
          path: /tmp/digests
          pattern: digests-*
          merge-multiple: true
      - uses: docker/setup-buildx-action@v4.2.0
      - uses: docker/login-action@v4.4.0
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Compute image name
        id: image
        run: echo "name=ghcr.io/$(echo '{% raw %}${{ github.repository }}{% endraw %}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_OUTPUT"
      - name: Create manifest list and push
        working-directory: /tmp/digests
        run: |
          docker buildx imagetools create \
            -t {% raw %}${{ steps.image.outputs.name }}:${{ github.ref_name }}{% endraw %} \
            -t {% raw %}${{ steps.image.outputs.name }}:latest{% endraw %} \
            $(printf '{% raw %}${{ steps.image.outputs.name }}{% endraw %}@sha256:%s ' *)
