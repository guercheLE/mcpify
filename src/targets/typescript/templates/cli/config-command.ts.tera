// {{ display_name }} MCP server — generated by mcpify. Do not hand-edit.

import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

import type { Command } from 'commander';
import yaml from 'js-yaml';

import { CREDENTIAL_ACCOUNT } from '../auth/auth-manager.js';
import {
  homeConfigPath,
  installDirConfigPath,
  loadConfig,
  localConfigPath,
  systemConfigPath,
} from '../core/config-manager.js';
import { builtInDefaults } from '../core/config-schema.js';
import { hasCredential } from '../core/credential-storage.js';
import { sanitize } from '../core/sanitizer.js';

const ENV_PREFIX = '{{ tool_prefix_env }}';

interface FileLayer {
  path: string;
  exists: boolean;
  contents?: unknown;
}

/** Resolves one config-file tier: its path (from the same helper `loadConfig` uses), whether it exists, and — only when it does — its sanitized parsed contents. */
function fileLayer(path: string): FileLayer {
  if (!existsSync(path)) {
    return { path, exists: false };
  }
  const parsed = (yaml.load(readFileSync(path, 'utf8')) as Record<string, unknown>) ?? {};
  return { path, exists: true, contents: sanitize(parsed) };
}

/** Every `{{ tool_prefix_env }}_*` variable actually present in `process.env` right now, sanitized — not just the subset `loadConfig`'s cascade consumes, since auth-credential vars (`_TOKEN`/`_USERNAME`/`_PASSWORD`/etc.) are read directly by auth-manager, outside the cascade, but are still real config-affecting env vars an operator would want to see. */
function environmentVariablesLayer(): Record<string, unknown> {
  const keys = Object.keys(process.env)
    .filter((key) => key.startsWith(`${ENV_PREFIX}_`))
    .sort();
  if (keys.length === 0) {
    return { note: `no ${ENV_PREFIX}_* environment variables are currently set` };
  }
  const raw = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
  return sanitize(raw) as Record<string, unknown>;
}

export function registerConfigCommand(program: Command): void {
  program
    .command('config')
    .description('Print the resolved configuration cascade, layer by layer (secrets redacted)')
    .action(async () => {
      const config = loadConfig();
      const dotenvPath = join(process.cwd(), '.env');

      const output = {
        cliFlags: {
          note:
            "the config command accepts no flags of its own; this layer is only populated when running via 'start'/'http' with overrides",
        },
        environmentVariables: environmentVariablesLayer(),
        localConfigFile: fileLayer(localConfigPath()),
        homeConfigFile: fileLayer(homeConfigPath()),
        systemConfigFile: fileLayer(systemConfigPath()),
        installDirConfigFile: fileLayer(installDirConfigPath()),
        builtInDefaults: sanitize(builtInDefaults()),
        dotenvNote: `a .env file in the current directory is detected but NEVER auto-loaded (this project has no dotenv dependency) — present: ${existsSync(dotenvPath)}`,
        credentialStorage: {
          authMethod: config.auth_method,
          credentialSaved: await hasCredential(CREDENTIAL_ACCOUNT),
        },
        resolved: sanitize(config),
      };

      console.log(JSON.stringify(output, null, 2));
    });
}
