// {{ display_name }} MCP server — generated by mcpify. Do not hand-edit.

import pino, { type Logger } from 'pino';

import { getCorrelationId } from './correlation-context.js';
import { logsToStdout, resolveLogTransport } from './log-transport.js';
import { REDACT_PATHS } from './sanitizer.js';

/** Builds the real pino instance. Called lazily (see `logger` below) since
 * the transport mode isn't known yet at module-evaluation time: `start`/
 * `http` (cli/start-command.ts, cli/http-command.ts) set
 * `{{ tool_prefix_env }}_TRANSPORT` inside a Commander `.action()` handler,
 * which runs only after every module's top-level code — including this
 * one's — has already finished importing. */
function createLogger(): Logger {
  const transport = resolveLogTransport();

  // Writes to stderr in stdio mode: the MCP stdio transport speaks
  // JSON-RPC over stdout, and pino defaults to that same stream, which
  // would corrupt every frame parsed on the client side. Writes to stdout
  // in HTTP mode instead, where stdout carries no protocol traffic.
  // `transport` (when set) routes its own destination itself (see
  // `resolveLogTransport`); the plain JSON path needs the explicit
  // `pino.destination(...)` since there's no transport object to carry it.
  const destination = transport ? undefined : pino.destination(logsToStdout() ? 1 : 2);

  return pino(
    {
      level: process.env['{{ tool_prefix_env }}_LOG_LEVEL'] ?? 'info',
      redact: { paths: REDACT_PATHS, censor: '[REDACTED]' },
      mixin() {
        const traceId = getCorrelationId();
        return traceId ? { traceId } : {};
      },
      transport,
    },
    destination,
  );
}

let instance: Logger | undefined;

/** Structured JSON logger with automatic secret redaction and traceId
 * correlation — REQ-2.3.1. A Proxy defers construction to first use (see
 * `createLogger`), so every call site keeps using `logger.info(...)`
 * unchanged. Methods are rebound to the real instance — pino's `Logger`
 * relies on internal `this` state a bare `Reflect.get` would leave bound
 * to the proxy instead. */
export const logger: Logger = new Proxy({} as Logger, {
  get(_target, property) {
    instance ??= createLogger();
    const value = Reflect.get(instance, property, instance);
    return typeof value === 'function' ? value.bind(instance) : value;
  },
});
