// Services bundles every dependency the Terminal Client / Harness Server
// roles need — built once by newServices and shared across every
// subcommand. mcpify always emits both stdio and HTTP capability;
// transport *selection* is runtime config (REQ-2.2's cascade), not a
// generation-time decision — mirrors `targets::python`'s
// `_run_harness_server()`.
type Services struct {
	Config      core.Config
	Store       *data.Store
	EmbedSvc    *services.EmbeddingService
	VectorStore *services.VectorStore
	ApiClient   *services.ApiClient
	AuthManager *auth.Manager
	Health      *core.Registry
	MCPServer   *server.MCPServer
	Logger      *zap.Logger
}

func newServices(ctx context.Context, overrides core.CLIOverrides) (*Services, error) {
	config, err := core.Load(overrides)
	if err != nil {
		return nil, err
	}

	logger, err := core.NewLogger()
	if err != nil {
		return nil, err
	}

	// CachedStore (not Open): backs the on-disk file up into memory once
	// per process and never re-touches the disk file afterward, so this
	// long-lived Harness Server process doesn't hold a lasting lock on
	// mcp_store.db against a fresh populate-embeddings run or a deployment
	// replacing the file — see CachedStore's doc comment.
	store, err := data.CachedStore(config.ApiVersion)
	if err != nil {
		return nil, err
	}

	cacheDir, err := services.ResolveCacheDir()
	if err != nil {
		return nil, err
	}
	sharedLibraryPath, err := services.ResolveSharedLibraryPath(ctx, cacheDir)
	if err != nil {
		return nil, err
	}
	embedSvc, err := services.NewEmbeddingService(ctx, cacheDir, sharedLibraryPath)
	if err != nil {
		return nil, err
	}

	chromemPath, err := data.ChromemPathFor(config.ApiVersion)
	if err != nil {
		return nil, err
	}
	vectorStore, err := services.NewVectorStore(chromemPath, embedSvc.Embed)
	if err != nil {
		return nil, err
	}

	credentialStore, err := core.NewCredentialStore()
	if err != nil {
		return nil, err
	}
	authManager, err := auth.NewManager(config.AuthMethod, auth.NewStrategies(), credentialStore)
	if err != nil {
		return nil, err
	}

	apiClient := services.NewApiClient(config)
	health := core.NewRegistry()
	mcpServer := core.NewMCPServer()
	tools.Register(mcpServer, store, vectorStore, apiClient, authManager, config.ApiVersion, logger)

	return &Services{
		Config:      config,
		Store:       store,
		EmbedSvc:    embedSvc,
		VectorStore: vectorStore,
		ApiClient:   apiClient,
		AuthManager: authManager,
		Health:      health,
		MCPServer:   mcpServer,
		Logger:      logger,
	}, nil
}

func (s *Services) Close() {
	// s.Store is intentionally not closed here — CachedStore returns a
	// process-wide connection shared and reused across the process's
	// lifetime, not one owned by this particular Services instance.
	_ = s.EmbedSvc.Close()
	// Error ignored: zap's Sync() is well known to return a spurious
	// EINVAL/ENOTTY on stderr/stdout for some OS/terminal combinations
	// (e.g. macOS), even though the preceding writes already succeeded —
	// the idiomatic zap pattern is a best-effort, error-ignored Sync().
	_ = s.Logger.Sync()
}

// RunStdioHarness starts the Harness Server over stdio.
func RunStdioHarness(ctx context.Context, overrides core.CLIOverrides) error {
	svc, err := newServices(ctx, overrides)
	if err != nil {
		return err
	}
	defer svc.Close()
	return server.ServeStdio(svc.MCPServer)
}

// RunHTTPHarness starts the Harness Server over HTTP.
func RunHTTPHarness(ctx context.Context, overrides core.CLIOverrides) error {
	svc, err := newServices(ctx, overrides)
	if err != nil {
		return err
	}
	defer svc.Close()

	{%- if "oauth1" in auth_method_keys %}
	if svc.Config.AuthMethod == core.AuthMethodOAuth1 {
		return &auth.Error{Message: "OAuth1 is not supported over HTTP transport: its signature must be recomputed per request against the destination URL using the server's consumer key/secret, which a simple incoming-header relay cannot provide. Use stdio transport for OAuth1-authenticated APIs, or switch auth_method."}
	}
	{%- endif %}
	headerLocation, headerName := auth.HeaderLocationFor(svc.Config.AuthMethod)

	// server.WithHTTPContextFunc is mcp-go's per-request (not per-session)
	// context-injection hook: it runs fresh for every incoming message
	// regardless of how long the underlying session's internal handling
	// lives, so extracting credentials here and threading them through ctx
	// works correctly across concurrent sessions — unlike a naive
	// middleware-set value, which would only cover the one HTTP request
	// that happened to carry the `initialize` call.
	mcpHandler := server.NewStreamableHTTPServer(svc.MCPServer, server.WithHTTPContextFunc(
		func(requestCtx context.Context, r *http.Request) context.Context {
			credentials, err := httptransport.ExtractRequestCredentials(r.Header, headerLocation, headerName)
			if err != nil {
				return requestCtx
			}
			return context.WithValue(requestCtx, auth.RequestCredentialsContextKey, credentials)
		},
	))
	handler, err := httptransport.NewHandler(mcpHandler, svc.Health, svc.Config.CorsAllow, headerLocation, headerName)
	if err != nil {
		return err
	}

	addr := fmt.Sprintf("%s:%d", svc.Config.Host, svc.Config.Port)
	fmt.Printf("listening on http://%s\n", addr)
	return http.ListenAndServe(addr, handler)
}

// PrintVersion prints the installed version.
func PrintVersion() {
	fmt.Println("1.0.0")
}

// envVarPrefix is every environment variable this project's config
// cascade (applyEnv) AND its auth manager (envCredentials — TOKEN,
// USERNAME, PASSWORD, API_KEY, CLIENT_ID, CLIENT_SECRET, CONSUMER_KEY,
// CONSUMER_SECRET, PRIVATE_KEY_PATH, read directly from os.LookupEnv
// outside this cascade entirely) share as a namespace. PrintConfig scans
// os.Environ() against this prefix directly rather than only the fixed
// keys applyEnv() knows about, so those auth-credential vars — very much
// config-affecting, from an operator's point of view — still show up.
const envVarPrefix = "{{ tool_prefix_env }}_"

// PrintConfig prints the resolved REQ-2.2 cascade grouped by source,
// highest-precedence-first (CLI flags win, so they're listed first here,
// even though core.Load itself applies tiers lowest-to-highest internally
// so each later tier can overwrite the last) — so `{{ project_name }}
// config` can actually answer "why is my config wrong" by showing which
// layer a value came from and which config files exist on disk, not just
// the final merged result. Every path shown is resolved through the exact
// same core.*ConfigPath helper Load itself calls. Secrets are never
// printed raw (REQ-2.3.1): file contents, defaults, and the resolved
// config's credentials are all routed through core's redaction
// primitives, and only a saved/not-saved boolean is shown for the stored
// credential itself.
func PrintConfig(overrides core.CLIOverrides) error {
	config, err := core.Load(overrides)
	if err != nil {
		return err
	}

	fmt.Println("CLI flags:")
	printCLIFlags(overrides)
	fmt.Println()

	fmt.Println("Environment variables:")
	printEnvVars()
	fmt.Println()

	localPath, localErr := core.LocalConfigPath()
	printConfigFileSection("Local config file", localPath, localErr)

	homePath, homeErr := core.HomeConfigPath()
	printConfigFileSection("Home config file", homePath, homeErr)

	printConfigFileSection("System config file", core.SystemConfigPath(), nil)

	installPath, installErr := core.InstallDirConfigPath()
	printConfigFileSection("Install-dir config file", installPath, installErr)

	fmt.Println("Built-in defaults:")
	printRedactedJSON(core.Defaults())
	fmt.Println()

	printDotenvNote()

	fmt.Println("Credential storage:")
	if err := printCredentialStorage(config.AuthMethod); err != nil {
		return err
	}
	fmt.Println()

	fmt.Println("Resolved (final merged) config:")
	fmt.Printf("  URL: %s\n", config.URL)
	fmt.Printf("  AuthMethod: %s\n", config.AuthMethod)
	fmt.Println("  Credentials: ***REDACTED***")
	fmt.Printf("  LogLevel: %s\n", config.LogLevel)
	fmt.Printf("  Transport: %s\n", config.Transport)
	fmt.Printf("  Host: %s\n", config.Host)
	fmt.Printf("  Port: %d\n", config.Port)
	return nil
}

// printCLIFlags shows exactly which persistent cobra flags were actually
// passed on THIS invocation — CLIOverrides only sets a pointer field when
// its flag was parsed, so a nil field means "not passed" rather than
// "passed as zero value".
func printCLIFlags(overrides core.CLIOverrides) {
	var flags []string
	if overrides.URL != nil {
		flags = append(flags, fmt.Sprintf("--url=%s", *overrides.URL))
	}
	if overrides.Host != nil {
		flags = append(flags, fmt.Sprintf("--host=%s", *overrides.Host))
	}
	if overrides.Port != nil {
		flags = append(flags, fmt.Sprintf("--port=%d", *overrides.Port))
	}
	if overrides.CorsAllow != nil {
		flags = append(flags, fmt.Sprintf("--cors-allow=%s", *overrides.CorsAllow))
	}
	if len(flags) == 0 {
		fmt.Println("  (none passed)")
		return
	}
	for _, flag := range flags {
		fmt.Printf("  %s\n", flag)
	}
}

// printEnvVars scans os.Environ() for every currently-set envVarPrefix-
// prefixed variable (not just the fixed keys applyEnv() knows about — see
// envVarPrefix's doc comment) and prints each as KEY=value, redacting
// values whose suffix (the part after envVarPrefix) matches core's
// sensitive-field deny-list via RedactMap.
func printEnvVars() {
	found := map[string]string{}
	for _, entry := range os.Environ() {
		key, value, ok := strings.Cut(entry, "=")
		if !ok || !strings.HasPrefix(key, envVarPrefix) {
			continue
		}
		found[key] = value
	}
	if len(found) == 0 {
		fmt.Println("  (none set)")
		return
	}

	bySuffix := make(map[string]any, len(found))
	for key, value := range found {
		bySuffix[strings.TrimPrefix(key, envVarPrefix)] = value
	}
	redacted := core.RedactMap(bySuffix)

	keys := make([]string, 0, len(found))
	for key := range found {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	for _, key := range keys {
		fmt.Printf("  %s=%v\n", key, redacted[strings.TrimPrefix(key, envVarPrefix)])
	}
}

// printConfigFileSection prints one file tier's absolute path plus whether
// it exists and (redacted) contents, or a resolution error if the tier's
// path couldn't be computed at all (e.g. os.UserHomeDir failing).
func printConfigFileSection(label, path string, pathErr error) {
	if pathErr != nil {
		fmt.Printf("%s: (unable to resolve path: %v)\n\n", label, pathErr)
		return
	}
	fmt.Printf("%s: %s\n", label, path)

	data, err := os.ReadFile(path)
	if err != nil {
		fmt.Println("  exists: false")
		fmt.Println()
		return
	}
	fmt.Println("  exists: true")

	redacted, err := core.RedactJSONBytes(data)
	if err != nil {
		fmt.Printf("  contents: (invalid JSON: %v)\n\n", err)
		return
	}
	fmt.Printf("  contents: %s\n\n", redacted)
}

// printRedactedJSON marshals value to JSON and prints it back out with
// core.RedactJSONBytes applied, indented under the current section.
func printRedactedJSON(value any) {
	data, err := json.Marshal(value)
	if err != nil {
		fmt.Printf("  (unable to encode: %v)\n", err)
		return
	}
	redacted, err := core.RedactJSONBytes(data)
	if err != nil {
		fmt.Printf("  (unable to redact: %v)\n", err)
		return
	}
	fmt.Printf("  %s\n", redacted)
}

// printDotenvNote flags that a .env file sitting in the current directory
// is never auto-loaded — this project has no dotenv dependency, unlike
// some of mcpify's other targets, so an operator who dropped secrets in
// one and expected the cascade to pick them up needs to be told why it
// didn't.
func printDotenvNote() {
	present := false
	if cwd, err := os.Getwd(); err == nil {
		if _, statErr := os.Stat(filepath.Join(cwd, ".env")); statErr == nil {
			present = true
		}
	}
	fmt.Printf("Note: a .env file in the current directory is detected but NEVER auto-loaded (this project has no dotenv dependency) — present: %t\n\n", present)
}

// printCredentialStorage shows the single auth method this project was
// generated for and whether a credential is currently persisted for it —
// never the credential's value (REQ-2.3.1).
func printCredentialStorage(method core.AuthMethod) error {
	display := string(method)
	if method == core.AuthMethodNone {
		display = "(none)"
	}
	fmt.Printf("  auth method: %s\n", display)

	credentialStore, err := core.NewCredentialStore()
	if err != nil {
		return err
	}
	saved, err := auth.HasStoredCredentials(credentialStore)
	if err != nil {
		return err
	}
	fmt.Printf("  credential saved: %t\n", saved)
	return nil
}

// PrintVersions lists the API spec versions this project has a store for
// (v8 multi-version support), showing which is default/active.
func PrintVersions(overrides core.CLIOverrides) error {
	config, err := core.Load(overrides)
	if err != nil {
		return err
	}
	for _, row := range KnownVersions {
		var markers []string
		if row.IsDefault {
			markers = append(markers, "default")
		}
		if row.Label == config.ApiVersion {
			markers = append(markers, "active")
		}
		if len(markers) > 0 {
			fmt.Printf("%s (%s)\n", row.Label, strings.Join(markers, ", "))
		} else {
			fmt.Println(row.Label)
		}
	}
	return nil
}

// RunSearch runs the search tool in-process, printing its result — the
// same tool implementation the MCP-protocol path uses (Story G6's
// tools.Search), just called directly instead of over stdio/HTTP.
func RunSearch(ctx context.Context, overrides core.CLIOverrides, query string, limit int) error {
	svc, err := newServices(ctx, overrides)
	if err != nil {
		return err
	}
	defer svc.Close()

	results, err := tools.Search(ctx, svc.VectorStore, query, limit)
	if err != nil {
		return err
	}
	return printJSON(results)
}

// RunGet runs the get tool in-process, printing its result.
func RunGet(ctx context.Context, overrides core.CLIOverrides, operationID string) error {
	svc, err := newServices(ctx, overrides)
	if err != nil {
		return err
	}
	defer svc.Close()

	result, err := tools.Get(svc.Store, operationID)
	if err != nil {
		return err
	}
	return printJSON(result)
}

// RunCall runs the call tool in-process, printing its result.
func RunCall(ctx context.Context, overrides core.CLIOverrides, operationID, argsJSON string) error {
	svc, err := newServices(ctx, overrides)
	if err != nil {
		return err
	}
	defer svc.Close()

	var args map[string]any
	if argsJSON != "" {
		if err := json.Unmarshal([]byte(argsJSON), &args); err != nil {
			return fmt.Errorf("invalid --args JSON: %w", err)
		}
	}

	result, err := tools.Call(ctx, svc.Store, svc.ApiClient, svc.AuthManager, svc.Config.ApiVersion, operationID, args, nil, svc.Logger)
	if err != nil {
		return err
	}
	return printJSON(result)
}

// RunPopulateEmbeddings backfills the vector store, printing how many
// operations were indexed.
func RunPopulateEmbeddings(ctx context.Context, overrides core.CLIOverrides) error {
	svc, err := newServices(ctx, overrides)
	if err != nil {
		return err
	}
	defer svc.Close()

	count, err := services.PopulateEmbeddings(ctx, svc.Store, svc.VectorStore)
	if err != nil {
		return err
	}
	fmt.Printf("populated %d embedding(s)\n", count)
	return nil
}

// RunSetup is implemented in setup.go (Story G7) — the interactive
// credential setup wizard.

// RunTestConnection verifies the configured API URL is reachable.
func RunTestConnection(ctx context.Context, overrides core.CLIOverrides) error {
	config, err := core.Load(overrides)
	if err != nil {
		return err
	}

	credentialStore, err := core.NewCredentialStore()
	if err != nil {
		return err
	}
	authManager, err := auth.NewManager(config.AuthMethod, auth.NewStrategies(), credentialStore)
	if err != nil {
		return err
	}
	headers, err := authManager.ApplyAuthHeaders(ctx, nil, http.MethodGet, config.URL, core.TransportStdio, nil)
	if err != nil {
		return err
	}

	client := &http.Client{Timeout: 5 * time.Second}
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, config.URL, http.NoBody)
	if err != nil {
		return err
	}
	for name, value := range headers {
		req.Header.Set(name, value)
	}
	resp, err := client.Do(req)
	if err != nil {
		return fmt.Errorf("connection failed: %w", err)
	}
	defer func() { _ = resp.Body.Close() }()
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return fmt.Errorf("connection failed: HTTP %d", resp.StatusCode)
	}
	fmt.Println("connection OK")
	return nil
}

func printJSON(value any) error {
	encoded, err := json.MarshalIndent(value, "", "  ")
	if err != nil {
		return err
	}
	fmt.Println(string(encoded))
	return nil
}
