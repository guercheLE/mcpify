#!/usr/bin/env bash
# {{ display_name }} MCP server — generated by mcpify. Do not hand-edit.
#
# Local pre-commit gate — mirrors the fast steps this project's CI
# (.github/workflows/ci.yml) runs before `go build`/`go test`, so a
# formatting, vet, or lint problem is caught before it ever reaches CI, not
# after.
#
# One-time setup (per clone): git config core.hooksPath .githooks
set -euo pipefail

echo "pre-commit: gofmt -l ."
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "$unformatted"
  exit 1
fi

echo "pre-commit: go vet ./..."
go vet ./...

echo "pre-commit: golangci-lint run"
golangci-lint run
