#!/usr/bin/env bash
# {{ display_name }} MCP server — generated by mcpify. Do not hand-edit.
#
# Local pre-commit gate — mirrors the first two (fast) steps of this
# project's CI (.github/workflows/ci.yml), so a formatting or lint problem
# is caught before it ever reaches CI, not after.
#
# One-time setup (per clone): git config core.hooksPath .githooks
set -euo pipefail

echo "pre-commit: cargo fmt --check"
cargo fmt --check

echo "pre-commit: cargo clippy --locked --all-targets -- -D warnings"
cargo clippy --locked --all-targets -- -D warnings
