// {{ display_name }} MCP server — generated by mcpify. Do not hand-edit.

use std::path::{Path, PathBuf};

use serde::Serialize;
use serde_json::{json, Map, Value};

use {{ crate_name }}::auth::auth_manager::CREDENTIAL_ACCOUNT;
use {{ crate_name }}::core::config_manager::{
    home_config_path, install_dir_config_path, load_config, local_config_path,
    read_yaml_if_exists, system_config_path,
};
use {{ crate_name }}::core::config_schema::built_in_defaults;
use {{ crate_name }}::core::credential_storage::has_credential;
use {{ crate_name }}::core::sanitizer::{is_sensitive_key, sanitize};

const ENV_PREFIX: &str = "{{ tool_prefix_env }}_";

/// Mirrors `config_manager::load_config`'s cascade one section per source
/// (highest precedence first), so `config` shows *where* each value came
/// from and *which* files even exist on disk — not just the merged result.
/// `resolved` (the old command's entire output) is kept last, additive
/// rather than a breaking removal of the previously-useful part.
#[derive(Serialize)]
struct ConfigReport {
    cli_flags: Value,
    environment_variables: Value,
    local_config_file: ConfigFileSection,
    home_config_file: ConfigFileSection,
    system_config_file: ConfigFileSection,
    install_dir_config_file: ConfigFileSection,
    built_in_defaults: Value,
    dotenv_note: String,
    credential_storage: CredentialStorageSection,
    resolved: Value,
}

#[derive(Serialize)]
struct ConfigFileSection {
    path: String,
    exists: bool,
    #[serde(skip_serializing_if = "Option::is_none")]
    contents: Option<Value>,
}

#[derive(Serialize)]
struct CredentialStorageSection {
    auth_method: Value,
    credential_saved: bool,
}

/// Absolute form of `path` for display. Only `local_config_path()` (a
/// relative path resolved against the process's current directory) ever
/// actually needs this; the other three cascade paths are absolute by
/// construction. Display-only — cascade resolution itself is untouched and
/// still reads each path exactly as `config_manager` returns it.
fn absolute_display(path: &Path) -> String {
    if path.is_absolute() {
        path.display().to_string()
    } else {
        std::env::current_dir()
            .map(|cwd| cwd.join(path).display().to_string())
            .unwrap_or_else(|_| path.display().to_string())
    }
}

fn file_section(path: PathBuf) -> ConfigFileSection {
    let exists = path.exists();
    let contents = exists.then(|| sanitize(&Value::Object(read_yaml_if_exists(&path))));
    ConfigFileSection {
        path: absolute_display(&path),
        exists,
        contents,
    }
}

/// Every `{{ tool_prefix_env }}_*` var actually present in the process
/// environment right now — deliberately broader than
/// `config_manager::env_overrides()`'s ~12 known cascade keys, since
/// auth-credential vars (`_TOKEN`, `_USERNAME`, `_PASSWORD`, `_API_KEY`,
/// `_CLIENT_ID`, `_CLIENT_SECRET`, `_CONSUMER_KEY`, `_CONSUMER_SECRET`,
/// `_PRIVATE_KEY_PATH`) are read directly by `auth::auth_manager`, outside
/// this cascade entirely, but are still real config-affecting env vars an
/// operator debugging "why is my config wrong" would want to see. Every
/// value is shown sanitized via the same sensitive-key-substring check
/// `sanitize()` applies to key names, so `_URL`/`_TRANSPORT`/`_LOG_LEVEL`
/// print their real value while secret-shaped keys print `[REDACTED]`
/// even if `sanitize()` wouldn't otherwise have recognized them.
fn environment_variables_section() -> Value {
    let mut vars: Vec<(String, String)> = std::env::vars()
        .filter(|(key, _)| key.starts_with(ENV_PREFIX))
        .collect();
    vars.sort_by(|a, b| a.0.cmp(&b.0));

    if vars.is_empty() {
        return json!({
            "note": "no {{ tool_prefix_env }}_* environment variables are currently set"
        });
    }

    let mut map = Map::new();
    for (key, value) in vars {
        let shown = if is_sensitive_key(&key) {
            "[REDACTED]".to_string()
        } else {
            value
        };
        map.insert(key, Value::String(shown));
    }
    Value::Object(map)
}

pub fn run() -> anyhow::Result<()> {
    // The `config` command itself takes no flags, so this layer is always
    // empty when invoked here — real CLI-flag overrides only ever reach
    // `load_config` via `start`/`http`.
    let config = load_config(Map::new())?;
    let resolved = sanitize(&serde_json::to_value(&config)?);
    let dotenv_present = Path::new(".env").exists();

    let report = ConfigReport {
        cli_flags: json!({
            "note": "the config command accepts no flags of its own; this layer is only populated when running via 'start'/'http' with overrides"
        }),
        environment_variables: environment_variables_section(),
        local_config_file: file_section(local_config_path()),
        home_config_file: file_section(home_config_path()),
        system_config_file: file_section(system_config_path()),
        install_dir_config_file: file_section(install_dir_config_path()),
        built_in_defaults: sanitize(&built_in_defaults()),
        dotenv_note: format!(
            "a .env file in the current directory is detected but NEVER auto-loaded (this project has no dotenv/dotenvy dependency) — present: {dotenv_present}"
        ),
        credential_storage: CredentialStorageSection {
            auth_method: resolved.get("auth_method").cloned().unwrap_or(Value::Null),
            credential_saved: has_credential(CREDENTIAL_ACCOUNT),
        },
        resolved,
    };

    println!("{}", serde_json::to_string_pretty(&report)?);
    Ok(())
}
