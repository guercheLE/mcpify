#!/usr/bin/env bash
# {{ display_name }} MCP server — generated by mcpify. Do not hand-edit.
#
# Local pre-commit gate — mirrors the fast format-check step this project's
# CI (.github/workflows/ci.yml) runs before `dotnet build`/`dotnet test`, so
# a formatting problem is caught before it ever reaches CI, not after.
# (Static-analysis warnings are enforced at build time via
# TreatWarningsAsErrors, not as a separate lint command, so there's no
# second fast gate to mirror here.)
#
# One-time setup (per clone): git config core.hooksPath .githooks
set -euo pipefail

echo "pre-commit: dotnet format --verify-no-changes"
dotnet format --verify-no-changes
