"""{{ display_name }} MCP server — generated by mcpify. Do not hand-edit.

`{{ project_name }} config` prints the cascade *by source* (REQ-2.2), not
just the final merged value — each layer, highest-precedence-first, plus
whether each candidate config file actually exists on disk. That's what
answers "why is my config wrong", which a single flat dump can't.
"""

from __future__ import annotations

import json
import os
from pathlib import Path
from typing import Any

import yaml

from ..auth.auth_manager import CREDENTIAL_ACCOUNT
from ..core.config import (
    ENV_PREFIX,
    built_in_defaults,
    home_config_path,
    install_dir_config_path,
    load_config,
    local_config_path,
    system_config_path,
)
from ..core.credential_storage import credential_exists
from ..core.logger import redact


def _env_vars_section() -> dict[str, Any]:
    """Every `{{ tool_prefix_env }}_*` var actually present in the process
    environment right now — not just the handful `_env_overrides()` folds
    into the cascade, since auth-credential vars (`_TOKEN`, `_USERNAME`,
    `_PASSWORD`, `_API_KEY`, `_CLIENT_ID`, `_CLIENT_SECRET`,
    `_CONSUMER_KEY`, `_CONSUMER_SECRET`, `_PRIVATE_KEY_PATH`) are read
    directly by the auth manager, outside this cascade entirely, but are
    still real config-affecting env vars an operator would want to see.
    """
    prefix = f"{ENV_PREFIX}_"
    found = {key: value for key, value in os.environ.items() if key.startswith(prefix)}
    if not found:
        return {"note": f"no {prefix}* environment variables are set"}
    return redact(found)


def _config_file_section(path: Path) -> dict[str, Any]:
    resolved = path.resolve()
    section: dict[str, Any] = {"path": str(resolved), "exists": resolved.is_file()}
    if section["exists"]:
        contents = yaml.safe_load(resolved.read_text())
        section["contents"] = redact(contents) if isinstance(contents, dict) else contents
    return section


def _dotenv_note() -> str:
    present = Path(".env").is_file()
    return (
        "a .env file in the current directory is detected but NEVER "
        "auto-loaded (this project has no python-dotenv dependency and "
        f"pydantic-settings' own env_file loading isn't enabled) — present: "
        f"{str(present).lower()}"
    )


def _credential_storage_section(auth_method: str) -> dict[str, Any]:
    return {
        "auth_method": auth_method,
        "credential_saved": credential_exists(CREDENTIAL_ACCOUNT),
    }


def run() -> None:
    config = load_config()

    report = {
        "cli_flags": {
            "note": (
                "the config command accepts no flags of its own; this layer "
                "is only populated when running via 'start'/'http' with "
                "overrides"
            )
        },
        "environment_variables": _env_vars_section(),
        "local_config_file": _config_file_section(local_config_path()),
        "home_config_file": _config_file_section(home_config_path()),
        "system_config_file": _config_file_section(system_config_path()),
        "install_dir_config_file": _config_file_section(install_dir_config_path()),
        "built_in_defaults": redact(built_in_defaults()),
        "dotenv_note": _dotenv_note(),
        "credential_storage": _credential_storage_section(config.auth_method.value),
        "resolved": redact(config.model_dump(mode="json")),
    }
    print(json.dumps(report, indent=2))
