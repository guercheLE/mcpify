name: Release

{% if publish_registry -%}
# Generated with --publish-registry: this project publishes to PyPI in
# addition to attaching a built wheel/sdist to a GitHub Release. Requires a
# UV_PUBLISH_TOKEN repo secret.
{% else -%}
# Mirrors targets::rust's release.yml: this project is a generated
# application tied to one specific API, not a reusable library, so
# "release" means attaching a built wheel/sdist to a GitHub Release on a
# version tag rather than publishing to PyPI. Re-run mcpify with
# --publish-registry if you want this project published to PyPI too.
{% endif -%}

on:
  push:
    tags:
      - "v*"

jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v8.2.0
      - uses: actions/setup-python@v6.3.0
        with:
          python-version: "3.12"
      - run: uv sync
      - run: uv run pytest
      - run: uv build
      - uses: softprops/action-gh-release@v3.0.1
        with:
          files: dist/*
{%- if publish_registry %}
      - run: uv publish --token {% raw %}${{ secrets.UV_PUBLISH_TOKEN }}{% endraw %}
{%- endif %}

  # Publishes the Dockerfile's image to GHCR, versioned by the release tag —
  # a real, pullable artifact of the release, not just the CI
  # build-validation docker-build.yml does on every push/PR. Uses the
  # built-in GITHUB_TOKEN, so no extra secret is needed. Builds each
  # platform natively on its own runner (no QEMU emulation) and pushes it by
  # digest only, then merge-image combines the digests into one multi-arch
  # manifest — Docker's documented pattern for build-push-action:
  # https://docs.docker.com/build/ci/github-actions/multi-platform/
  # ubuntu-24.04-arm is a GitHub-hosted native arm64 runner (not emulated),
  # free for public repos and billed at the same/lower per-minute rate as
  # amd64 for private ones.
  build-image:
    needs: release
    strategy:
      fail-fast: false
      matrix:
        platform:
          - { arch: amd64, runner: ubuntu-24.04 }
          - { arch: arm64, runner: ubuntu-24.04-arm }
    runs-on: {% raw %}${{ matrix.platform.runner }}{% endraw %}
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v7
      - uses: docker/setup-buildx-action@v4.2.0
      - uses: docker/login-action@v4.4.0
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Compute image name
        id: image
        # GHCR image names must be lowercase, but github.repository isn't
        # guaranteed to be (e.g. a mixed-case GitHub username/org).
        run: echo "name=ghcr.io/$(echo '{% raw %}${{ github.repository }}{% endraw %}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_OUTPUT"
      - name: Build and push by digest
        id: build
        uses: docker/build-push-action@v7.3.0
        with:
          context: .
          platforms: linux/{% raw %}${{ matrix.platform.arch }}{% endraw %}
          outputs: type=image,name={% raw %}${{ steps.image.outputs.name }}{% endraw %},push-by-digest=true,name-canonical=true,push=true
      - name: Export digest
        run: |
          mkdir -p /tmp/digests
          digest="{% raw %}${{ steps.build.outputs.digest }}{% endraw %}"
          touch "/tmp/digests/${digest#sha256:}"
      - name: Upload digest
        uses: actions/upload-artifact@v7
        with:
          name: digests-{% raw %}${{ matrix.platform.arch }}{% endraw %}
          path: /tmp/digests/*
          if-no-files-found: error
          retention-days: 1

  merge-image:
    needs: build-image
    runs-on: ubuntu-24.04
    permissions:
      packages: write
    steps:
      - name: Download digests
        uses: actions/download-artifact@v8
        with:
          path: /tmp/digests
          pattern: digests-*
          merge-multiple: true
      - uses: docker/setup-buildx-action@v4.2.0
      - uses: docker/login-action@v4.4.0
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Compute image name
        id: image
        run: echo "name=ghcr.io/$(echo '{% raw %}${{ github.repository }}{% endraw %}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_OUTPUT"
      - name: Create manifest list and push
        working-directory: /tmp/digests
        run: |
          docker buildx imagetools create \
            -t {% raw %}${{ steps.image.outputs.name }}:${{ github.ref_name }}{% endraw %} \
            -t {% raw %}${{ steps.image.outputs.name }}:latest{% endraw %} \
            $(printf '{% raw %}${{ steps.image.outputs.name }}{% endraw %}@sha256:%s ' *)
