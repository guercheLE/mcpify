from __future__ import annotations

from pathlib import Path

from {{ module_name }}.services.embedding_service import _resolve_cache_dir_from


def test_override_dir_wins_over_home_dir() -> None:
    resolved = _resolve_cache_dir_from("/explicit/cache", "/home/user", "/opt/app")
    assert resolved == Path("/explicit/cache")


def test_falls_back_to_home_dir_when_no_override_is_set() -> None:
    resolved = _resolve_cache_dir_from(None, "/home/user", "/opt/app")
    assert resolved == Path("/home/user") / ".{{ project_name }}" / "models"


def test_falls_back_to_app_dir_when_neither_override_nor_home_is_set() -> None:
    resolved = _resolve_cache_dir_from(None, None, "/opt/app")
    assert resolved == Path("/opt/app") / ".{{ project_name }}" / "models"
