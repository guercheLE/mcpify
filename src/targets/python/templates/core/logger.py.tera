"""{{ display_name }} MCP server — generated by mcpify. Do not hand-edit.

`structlog` configuration: JSON output (pretty on an interactive TTY),
level from `{{ tool_prefix_env }}_LOG_LEVEL` (default `"info"`), and
automatic redaction of sensitive fields (REQ-2.3.1) via a processor —
structlog's processor chain is a first-class fit for this, no separate
sanitizer module needed the way other targets require one.
"""

from __future__ import annotations

import logging
import os
import sys
from typing import Any

import structlog

LOG_LEVEL_ENV_VAR = "{{ tool_prefix_env }}_LOG_LEVEL"
TRANSPORT_ENV_VAR = "{{ tool_prefix_env }}_TRANSPORT"

_REDACTED_KEYS = {
    "password",
    "token",
    "secret",
    "api_key",
    "apikey",
    "authorization",
    "client_secret",
    "consumer_secret",
    "private_key",
    "access_token",
    "refresh_token",
}
_REDACTED_VALUE = "[REDACTED]"


def resolve_log_level() -> str:
    return os.environ.get(LOG_LEVEL_ENV_VAR, "info")


def _is_sensitive_key(key: str) -> bool:
    """Substring match (case-insensitive), not exact match — so prefixed
    names like `{{ tool_prefix_env }}_TOKEN` or nested keys like
    `auth_token` are caught too. Mirrors `is_sensitive_key` in the Rust
    target's `sanitizer.rs` and the regex in the TypeScript target's
    `sanitizer.ts`.
    """
    lowered = key.lower()
    return any(marker in lowered for marker in _REDACTED_KEYS)


def redact(data: dict[str, Any]) -> dict[str, Any]:
    """Recursively redacts sensitive fields from an arbitrary dict, walking
    into nested dicts and lists — the same field list
    `_redact_sensitive_fields` applies to log events, reused by
    `cli/config.py` (Story P5) so `{{ project_name }} config` never prints
    a raw secret to the terminal, including secrets nested inside grouped
    sections (env vars, config-file contents, etc.). Mirrors `sanitize()`
    in the Rust and TypeScript targets' `sanitizer` modules.
    """
    return {key: _redact_entry(key, value) for key, value in data.items()}


def _redact_entry(key: str, value: Any) -> Any:
    if _is_sensitive_key(key):
        return _REDACTED_VALUE
    return _redact_walk(value)


def _redact_walk(value: Any) -> Any:
    if isinstance(value, dict):
        return {key: _redact_entry(key, val) for key, val in value.items()}
    if isinstance(value, list):
        return [_redact_walk(item) for item in value]
    return value


def _redact_sensitive_fields(
    _logger: Any, _method_name: str, event_dict: dict[str, Any]
) -> dict[str, Any]:
    for key in event_dict:
        if _is_sensitive_key(key):
            event_dict[key] = _REDACTED_VALUE
    return event_dict


def init_logging() -> None:
    """Installs the process-global structured logger. Call once, at
    process startup, before any `structlog.get_logger()` call elsewhere.

    The MCP stdio transport speaks JSON-RPC over stdout, so logs must go
    to stderr in that mode to avoid corrupting the protocol stream. Over
    HTTP, stdout carries no protocol traffic, so logs go there instead —
    the conventional destination for container/process-manager log
    collection.
    """
    level = getattr(logging, resolve_log_level().upper(), logging.INFO)
    stream = sys.stdout if os.environ.get(TRANSPORT_ENV_VAR) == "http" else sys.stderr
    renderer = (
        structlog.dev.ConsoleRenderer()
        if stream.isatty()
        else structlog.processors.JSONRenderer()
    )

    structlog.configure(
        processors=[
            structlog.contextvars.merge_contextvars,
            structlog.processors.add_log_level,
            structlog.processors.TimeStamper(fmt="iso"),
            _redact_sensitive_fields,
            structlog.processors.StackInfoRenderer(),
            structlog.processors.format_exc_info,
            renderer,
        ],
        wrapper_class=structlog.make_filtering_bound_logger(level),
        context_class=dict,
        logger_factory=structlog.PrintLoggerFactory(file=stream),
        cache_logger_on_first_use=True,
    )


def get_logger(name: str | None = None) -> structlog.stdlib.BoundLogger:
    return structlog.get_logger(name)
