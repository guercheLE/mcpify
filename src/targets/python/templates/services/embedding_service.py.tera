"""{{ display_name }} MCP server — generated by mcpify. Do not hand-edit.

Computes embeddings with `sentence-transformers`' `all-mpnet-base-v2` —
run natively, no ONNX/`fastembed`-style indirection needed, since this
target's runtime *is* Python. Imported by both the `search` tool and
`services/populate_embeddings.py`, so the exact same function computes
vectors at generation time and at live-query time — if the two diverged,
cosine similarity would break silently.
"""

from __future__ import annotations

import os
from functools import lru_cache
from pathlib import Path
from typing import TYPE_CHECKING

# `tokenizers`' Rayon thread pool acquires the GIL from its worker threads
# once parallelism is enabled, which registers them with the interpreter
# and makes CPython's shutdown (Py_FinalizeEx, which — since Python
# 3.9 — waits for every such thread, not just non-daemon ones) hang
# forever, since Rayon's global pool never voluntarily exits. Must be set
# before `sentence_transformers`/`tokenizers` is first imported anywhere
# in the process (including `populate_embeddings` and `pytest`), so it's
# set here at module import time rather than inside `_model()`.
os.environ.setdefault("TOKENIZERS_PARALLELISM", "false")

if TYPE_CHECKING:
    from sentence_transformers import SentenceTransformer

MODEL_NAME = "sentence-transformers/all-mpnet-base-v2"
CACHE_DIR_ENV_VAR = "{{ tool_prefix_env }}_CACHE_DIR"


def _resolve_cache_dir_from(override_dir: str | None, home_dir: str | None, app_dir: str) -> Path:
    """Pure resolution logic behind `resolve_cache_dir` — explicit inputs
    instead of reading the environment directly, so precedence is
    unit-testable without mutating real process env vars.
    """
    if override_dir:
        return Path(override_dir)
    if home_dir:
        return Path(home_dir) / ".{{ project_name }}" / "models"
    return Path(app_dir) / ".{{ project_name }}" / "models"


def resolve_cache_dir() -> Path:
    """Resolves the embedding model cache directory with an explicit,
    CWD-independent 3-tier precedence — replacing the previous bare
    relative literal (`.sentence_transformers_cache`), which silently
    landed wherever the process happened to be launched from (a systemd
    unit, a Docker WORKDIR, a random shell cwd, ...):
    1. `{{ tool_prefix_env }}_CACHE_DIR`, if set — an explicit override.
    2. `~/.{{ project_name }}/models` — a stable per-user location, the
       same `~/.{{ project_name }}/...` convention every other target uses
       for its own downloaded models.
    3. A directory next to this installed package — the final,
       always-absolute fallback when neither of the above is available
       (e.g. no HOME in a locked-down container). Mirrors `core/config.py`'s
       `_install_dir()`.
    """
    return _resolve_cache_dir_from(
        os.environ.get(CACHE_DIR_ENV_VAR),
        os.environ.get("HOME") or os.environ.get("USERPROFILE"),
        str(Path(__file__).resolve().parent.parent),
    )


@lru_cache(maxsize=1)
def _model() -> SentenceTransformer:
    # Imported lazily, not at module level, so commands that never touch
    # embeddings (e.g. `version`, `config`) don't pay sentence-transformers'
    # torch-backed import cost on every CLI invocation.
    from sentence_transformers import SentenceTransformer

    return SentenceTransformer(MODEL_NAME, cache_folder=str(resolve_cache_dir()))


def embed(text: str) -> list[float]:
    vector = _model().encode(text, normalize_embeddings=True)
    return vector.tolist()
